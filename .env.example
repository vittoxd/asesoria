# ─────────────────────────────────────────────────────────────
# Variables de entorno de AsesorIA
# Copia este archivo como .env.local y rellena los valores.
# En producción (Vercel) se configuran en el panel del proyecto.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Neon, Supabase, Railway, etc.)
# Formato: postgresql://usuario:password@host/dbname?sslmode=require
DATABASE_URL=""

# Secreto para firmar las sesiones (NextAuth v5).
# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# En Vercel/producción, deja AUTH_TRUST_HOST en true para que NextAuth confíe en el host del deploy.
AUTH_TRUST_HOST="true"
